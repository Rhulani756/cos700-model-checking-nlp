{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Model Checking & NLP",
  "version": "0.1.0",
  "identifier": "com.jessi.desktop",
  "build": {
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "Model Checking & NLP Feedback",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/backend-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
